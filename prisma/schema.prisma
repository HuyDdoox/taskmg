generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  fullName     String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  reportedTasks  Task[]          @relation("TaskReporter")
  messages       Message[]
  activityLogs   ActivityLog[]
}

model Project {
  id          String          @id @default(uuid())
  name        String
  projectKey  String          @unique // e.g. "TASK"
  description String?
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  milestones  Milestone[]
  columns     KanbanColumn[]
  tasks       Task[]
  channels    ChatChannel[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // ADMIN | PM | MEMBER | VIEWER
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  title     String
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("UPCOMING") // UPCOMING | IN_PROGRESS | COMPLETED
  createdAt DateTime  @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model KanbanColumn {
  id        String   @id @default(uuid())
  projectId String
  title     String
  position  Int
  colorHex  String   @default("#6B7280")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id          String          @id @default(uuid())
  taskNumber  Int
  issueKey    String          @unique // e.g. "TASK-1"
  title       String
  description String?
  issueType   String          @default("TASK") // TASK | STORY | BUG | SUBTASK
  priority    String          @default("MEDIUM") // LOWEST | LOW | MEDIUM | HIGH | BLOCKER
  riskLevel   String          @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  columnId    String
  milestoneId String?
  assigneeId  String?
  reporterId  String
  orderIndex  Float           @default(1000)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  column      KanbanColumn    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  milestone   Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee    User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User            @relation("TaskReporter", fields: [reporterId], references: [id])
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  checklists  TaskChecklist[]
  activityLogs ActivityLog[]
}

model TaskChecklist {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ChatChannel {
  id        String    @id @default(uuid())
  projectId String
  name      String
  type      String    @default("PUBLIC") // PUBLIC | PRIVATE
  createdAt DateTime  @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id            String      @id @default(uuid())
  channelId     String
  senderId      String
  content       String
  attachmentUrl String?
  createdAt     DateTime    @default(now())

  channel       ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  action      String   // CREATED | STATUS_CHANGED | REASSIGNED | PRIORITY_UPDATED
  detailsJson String?  // JSON string
  createdAt   DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}
